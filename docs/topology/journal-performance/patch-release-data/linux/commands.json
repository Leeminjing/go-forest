[
  {
    "name": "go-version",
    "command": [
      "/usr/local/go/bin/go",
      "version"
    ]
  },
  {
    "name": "download",
    "command": [
      "/usr/local/go/bin/go",
      "mod",
      "download",
      "-json",
      "github.com/Leeminjing/go-forest/extensions/topology@v0.2.1"
    ]
  },
  {
    "name": "tidy",
    "command": [
      "/usr/local/go/bin/go",
      "mod",
      "tidy"
    ]
  },
  {
    "name": "verify",
    "command": [
      "/usr/local/go/bin/go",
      "mod",
      "verify"
    ]
  },
  {
    "name": "modules",
    "command": [
      "/usr/local/go/bin/go",
      "list",
      "-m",
      "-json",
      "all"
    ]
  },
  {
    "name": "packages",
    "command": [
      "/usr/local/go/bin/go",
      "list",
      "-test",
      "-deps",
      "-json",
      "./..."
    ]
  },
  {
    "name": "vet",
    "command": [
      "/usr/local/go/bin/go",
      "vet",
      "./..."
    ]
  },
  {
    "name": "test",
    "command": [
      "/usr/local/go/bin/go",
      "test",
      "-race",
      "./...",
      "-v",
      "-count=3",
      "-timeout=120s"
    ]
  }
]